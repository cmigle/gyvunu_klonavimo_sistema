@model InkubavimoParametrai

<fieldset>
    <legend>Inkubavimo parametrai</legend>
    <div class="tinklelis">
        <div laukas-for="TikslineTemperatura">
            <label asp-for="TikslineTemperatura"></label>
            <input asp-for="TikslineTemperatura" type="number" min="20" max="45" step="0.1">
        </div>
        <div laukas-for="Co2Procentas">
            <label asp-for="Co2Procentas"></label>
            <input asp-for="Co2Procentas" type="number" min="0" max="20" step="0.1">
        </div>
        <div laukas-for="O2Procentas">
            <label asp-for="O2Procentas"></label>
            <input asp-for="O2Procentas" type="number" min="1" max="21" step="0.1">
        </div>
        <div laukas-for="PhLygis">
            <label asp-for="PhLygis"></label>
            <input asp-for="PhLygis" type="number" min="6" max="8.5" step="0.01">
        </div>
    </div>
</fieldset>
