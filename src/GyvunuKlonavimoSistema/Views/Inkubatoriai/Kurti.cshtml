@model InkubatoriausKurimoForma
@{
    ViewData["Title"] = "Naujo inkubatoriaus kūrimo langas";
    ViewData["Posisteme"] = Posisteme.Inkubatoriai;
    ViewData["Aprasas"] = "Naujai sukurtas inkubatorius gauna būseną „Laisvas“.";
    ViewData["Kelias"] = new[] { new KelioDalis("Inkubatoriai", "/inkubatoriai"), new KelioDalis("Naujas inkubatorius") };
}

<form class="kortele" method="post" novalidate>
    <div class="tinklelis">
        <div laukas-for="Modelis">
            <label asp-for="Modelis"></label>
            <input asp-for="Modelis">
        </div>
        <div laukas-for="SerijinisNumeris">
            <label asp-for="SerijinisNumeris"></label>
            <input asp-for="SerijinisNumeris">
        </div>
        <div laukas-for="Talpa">
            <label asp-for="Talpa"></label>
            <input asp-for="Talpa" type="number" min="1" max="1000" step="0.1">
        </div>
    </div>
    <partial name="_Parametrai" model="Model" />
    <div class="mygtukai">
        <button type="submit" class="mygtukas">Sukurti</button>
        <a class="mygtukas antrinis" asp-action="Index">Atšaukti</a>
    </div>
</form>
